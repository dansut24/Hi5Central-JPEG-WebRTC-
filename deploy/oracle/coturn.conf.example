# Optional dedicated coturn. Do not overwrite existing TURN configs.
listening-port=3478
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
realm=share.example.com
no-multicast-peers
min-port=49160
max-port=49200
# Set external-ip when behind OCI NAT; open these UDP ports in OCI VCN and OS firewall.
